# This file is a template. Real .env files are generated from config.yml by scripts/generate_envs.sh

# Common
PROJECT_NAME=graphiti-memory
ENVIRONMENT=development

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password_here

# Redis
REDIS_URL=redis://redis:6379/0

# LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-LLM_KEY_HERE
LLM_MODEL=gpt-4o-mini

# Fast LLM (for simple operations: deduplication, validation)
LLM_FAST_BASE_URL=https://api.openai.com/v1
LLM_FAST_API_KEY=sk-LLM_KEY_HERE
LLM_FAST_MODEL=qwen2.5:7b

# Embeddings
# For Russian language, consider: text-embedding-3-large, qwen3-embedding
# WARNING: Changing embedding model requires reindexing all episodes!
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-EMBEDDING_KEY_HERE
EMBEDDING_MODEL=text-embedding-3-small

# Reranker
RERANKER_BASE_URL=https://api.openai.com/v1
RERANKER_API_KEY=sk-RERANKER_KEY_HERE
RERANKER_MODEL=reranker-001

# Extraction Instructions (guides LLM during entity/edge extraction)
# Helps extract lists, rules, and standalone facts that don't fit entity-pair schema
CUSTOM_EXTRACTION_INSTRUCTIONS=Extract relationships AND standalone rules/instructions/preferences. If the text contains a numbered or bulleted list of rules, extract EACH rule as a separate fact with its full content, even if the rule does not connect two named entities. Use the rule itself as the fact text. Prefer completeness over entity-pair strictness. For Russian texts, preserve the original content in the fact.

# Search quality
# SEARCH_MIN_SCORE: Minimum relevance score threshold (0.0-1.0). 0.0 = no filtering.
# Set to 0.5-0.7 to filter out low-relevance noise from search results.
SEARCH_MIN_SCORE=0.0
# USE_RERANKER: true = use cross-encoder reranker, false = fallback to RRF (faster, less accurate)
# Default true, will use cross-encoder reranker
USE_RERANKER=true
RERANKER_TIMEOUT=30
RERANKER_MAX_RETRIES=1

# Adapter
ADAPTER_API_KEY=adapter-secret-api-key
JWT_SECRET=supersecretjwtkey
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password_here

# Frontend
VITE_API_BASE_URL=http://localhost:8000
